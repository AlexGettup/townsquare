# URL of the voice chat server (see voice-server/README.md),
# e.g. https://townsquare-voice.<your-account>.workers.dev
# Leave it empty to hide the voice chat button.
VUE_APP_VOICE_URL=https://townsquare-voice.townsquare-voice.workers.dev

# Server the games sync through: "own" (the voice server above, see
# voice-server/src/live.js) or "original" (the original project's server,
# clocktower.live). Voice and text chat stay on the voice server either way.
# Without a voice server, games always use the original one.
VUE_APP_LIVE_SERVER=own
